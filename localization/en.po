#, c-format
msgid "力量：%s\n每秒增长：%s"
msgstr "Force: %s\nGrowth per second: %s"

#, c-format
msgid "提前结束 · 青色 %d 票 / 橙色 %d 票\n%s占领全部州，提前获胜。剩余时间 %s。"
msgstr "Early finish · Cyan %d votes / Orange %d votes\n%s controls every state and wins early. Time remaining: %s."

